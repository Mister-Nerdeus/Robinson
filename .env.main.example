# Main / public deployment template
RUNTIME_MODE=production
SITE_URL=https://www.robinsonseptic.com
LOCAL_ONLY_MODE=false
ALLOW_ADMIN_OUTSIDE_LOCAL_MODE=false
ENABLE_ADMIN_SUBMISSIONS_REVIEW=false
REVIEW_SURFACES_VISIBLE=false

# Keep hidden on public unless explicitly enabled with full provenance values
DEPLOYMENT_STAMP_VISIBLE=false
DEPLOY_COMMIT_SHA=
DEPLOY_REF=refs/heads/main
DEPLOY_BUILD_TIME_UTC=

SEO_ALLOW_INDEXING=true
APP_PORT=4850

NOTIFICATION_MODE=smtp
NOTIFICATION_TO_EMAIL=service@robinsonseptic.com
NOTIFICATION_FROM_EMAIL=no-reply@robinsonseptic.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=900000

ANALYTICS_ENABLED=true
ANALYTICS_PROVIDER=internal
# Main / public deployment template
RUNTIME_MODE=production
SITE_URL=https://robinsonseptic.net
LOCAL_ONLY_MODE=false
ALLOW_ADMIN_OUTSIDE_LOCAL_MODE=false
ENABLE_ADMIN_SUBMISSIONS_REVIEW=false
REVIEW_SURFACES_VISIBLE=false
ADMIN_OWNER_TOKEN=
ADMIN_OPS_TOKEN=
ADMIN_SESSION_COOKIE_NAME=robinson_admin_session
ENABLE_LOCAL_DEV_ADMIN_BYPASS=false
REVIEW_ALLOWED_HOSTS=localhost,127.0.0.1
SUBMISSIONS_DB_PATH=data/submissions.sqlite

# Keep hidden on public unless explicitly enabled with full provenance values
DEPLOYMENT_STAMP_VISIBLE=false
DEPLOY_COMMIT_SHA=
DEPLOY_REF=refs/heads/main
DEPLOY_BUILD_TIME_UTC=

SEO_ALLOW_INDEXING=true
REQUEST_LAYOUT_CONTRACT_VERSION=request-desktop-modes-v5
RUNTIME_SECURITY_CONTRACT_VERSION=runtime-security-2026-04-v1
APP_PORT=4850

NOTIFICATION_MODE=
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_INTERNAL_TO_EMAIL=service@robinsonseptic.net
NOTIFICATION_TO_EMAIL=service@robinsonseptic.net
NOTIFICATION_FROM_EMAIL=no-reply@notify.robinsonseptic.net
NOTIFICATION_FROM_NAME=Robinson Septic Intake
NOTIFICATION_REPLY_TO_EMAIL=service@robinsonseptic.net
NOTIFICATION_LANE_TO_EMAIL_MAP=general:service@robinsonseptic.net;septic-service:dispatch@robinsonseptic.net;evaluation:info@robinsonseptic.net;rental:rentals@robinsonseptic.net;commercial-service:dispatch@robinsonseptic.net
NOTIFICATION_SUBJECT_PREFIX=[MAIN]
NOTIFICATION_DEVELOP_SAFE_INBOX_PATTERN=develop|sandbox|test
SMTP_PROFILE=generic
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@notify.robinsonseptic.net
NOTIFICATION_SENDING_DOMAIN_POLICY=dedicated-subdomain
NOTIFICATION_SENDING_ROOT_DOMAIN=robinsonseptic.net
NOTIFICATION_SENDING_SUBDOMAIN=notify
NOTIFICATION_PROVIDER_SENDING_DOMAIN=
NOTIFICATION_DNS_VERIFIED=false
NOTIFICATION_DNS_SPF_VERIFIED=false
NOTIFICATION_DNS_DKIM_VERIFIED=false
NOTIFICATION_DNS_DMARC_POSTURE=not-set

RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MODE=file
ABUSE_CHALLENGE_MODE=shadow
ABUSE_TRUSTED_IPS=
ABUSE_TRUSTED_EMAILS=
SUBMISSION_RETENTION_DAYS=365

ANALYTICS_ENABLED=true
ANALYTICS_PROVIDER=internal

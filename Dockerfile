FROM node:22-alpine AS deps
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package*.json ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG RUNTIME_MODE
ARG SITE_URL
ARG LOCAL_ONLY_MODE
ARG ALLOW_ADMIN_OUTSIDE_LOCAL_MODE

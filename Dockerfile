ENV NOTIFICATION_DNS_DMARC_POSTURE=$NOTIFICATION_DNS_DMARC_POSTURE
ENV ABUSE_CHALLENGE_MODE=$ABUSE_CHALLENGE_MODE
ENV ABUSE_TRUSTED_IPS=$ABUSE_TRUSTED_IPS
ENV ABUSE_TRUSTED_EMAILS=$ABUSE_TRUSTED_EMAILS
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build
RUN npm prune --omit=dev


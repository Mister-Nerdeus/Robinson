ENV SMTP_PORT=$SMTP_PORT
ENV SMTP_USER=$SMTP_USER
ENV SMTP_PASS=$SMTP_PASS
ENV SMTP_SECURE=$SMTP_SECURE
ENV RESEND_API_KEY=$RESEND_API_KEY
ENV RESEND_FROM_EMAIL=$RESEND_FROM_EMAIL
ENV NOTIFICATION_SENDING_DOMAIN_POLICY=$NOTIFICATION_SENDING_DOMAIN_POLICY
ENV NOTIFICATION_SENDING_ROOT_DOMAIN=$NOTIFICATION_SENDING_ROOT_DOMAIN
ENV NOTIFICATION_SENDING_SUBDOMAIN=$NOTIFICATION_SENDING_SUBDOMAIN

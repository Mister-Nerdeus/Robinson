ARG ABUSE_TRUSTED_IPS
ARG ABUSE_TRUSTED_EMAILS
ENV RUNTIME_MODE=$RUNTIME_MODE
ENV SITE_URL=$SITE_URL
ENV LOCAL_ONLY_MODE=$LOCAL_ONLY_MODE
ENV ALLOW_ADMIN_OUTSIDE_LOCAL_MODE=$ALLOW_ADMIN_OUTSIDE_LOCAL_MODE
ENV ENABLE_ADMIN_SUBMISSIONS_REVIEW=$ENABLE_ADMIN_SUBMISSIONS_REVIEW
ENV REVIEW_SURFACES_VISIBLE=$REVIEW_SURFACES_VISIBLE
ENV ADMIN_OWNER_TOKEN=$ADMIN_OWNER_TOKEN
ENV ADMIN_OPS_TOKEN=$ADMIN_OPS_TOKEN
ENV ADMIN_SESSION_COOKIE_NAME=$ADMIN_SESSION_COOKIE_NAME
ENV ENABLE_LOCAL_DEV_ADMIN_BYPASS=$ENABLE_LOCAL_DEV_ADMIN_BYPASS
ENV REVIEW_ALLOWED_HOSTS=$REVIEW_ALLOWED_HOSTS
ENV SUBMISSIONS_DB_PATH=$SUBMISSIONS_DB_PATH
ENV DEPLOYMENT_STAMP_VISIBLE=$DEPLOYMENT_STAMP_VISIBLE
ENV DEPLOY_COMMIT_SHA=$DEPLOY_COMMIT_SHA
ENV DEPLOY_REF=$DEPLOY_REF
ENV DEPLOY_BUILD_TIME_UTC=$DEPLOY_BUILD_TIME_UTC
ENV SEO_ALLOW_INDEXING=$SEO_ALLOW_INDEXING
ENV REQUEST_LAYOUT_CONTRACT_VERSION=$REQUEST_LAYOUT_CONTRACT_VERSION
ENV RATE_LIMIT_MODE=$RATE_LIMIT_MODE
ENV SUBMISSION_RETENTION_DAYS=$SUBMISSION_RETENTION_DAYS
ENV NOTIFICATION_MODE=$NOTIFICATION_MODE
ENV NOTIFICATION_MAX_ATTEMPTS=$NOTIFICATION_MAX_ATTEMPTS
ENV NOTIFICATION_INTERNAL_TO_EMAIL=$NOTIFICATION_INTERNAL_TO_EMAIL
ENV NOTIFICATION_TO_EMAIL=$NOTIFICATION_TO_EMAIL
ENV NOTIFICATION_FROM_EMAIL=$NOTIFICATION_FROM_EMAIL
ENV NOTIFICATION_FROM_NAME=$NOTIFICATION_FROM_NAME
ENV NOTIFICATION_REPLY_TO_EMAIL=$NOTIFICATION_REPLY_TO_EMAIL
ENV NOTIFICATION_LANE_TO_EMAIL_MAP=$NOTIFICATION_LANE_TO_EMAIL_MAP
ENV NOTIFICATION_SUBJECT_PREFIX=$NOTIFICATION_SUBJECT_PREFIX
ENV NOTIFICATION_DEVELOP_SAFE_INBOX_PATTERN=$NOTIFICATION_DEVELOP_SAFE_INBOX_PATTERN
ENV SMTP_PROFILE=$SMTP_PROFILE

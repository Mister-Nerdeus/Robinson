# Local developer defaults
RUNTIME_MODE=local
SITE_URL=http://localhost:4850
LOCAL_ONLY_MODE=true
ALLOW_ADMIN_OUTSIDE_LOCAL_MODE=false
ENABLE_ADMIN_SUBMISSIONS_REVIEW=false
REVIEW_SURFACES_VISIBLE=true
ADMIN_OWNER_TOKEN=local-owner-token-0123456789
ADMIN_OPS_TOKEN=local-ops-token-0123456789
ADMIN_SESSION_COOKIE_NAME=robinson_admin_session
ENABLE_LOCAL_DEV_ADMIN_BYPASS=false
REVIEW_ALLOWED_HOSTS=localhost,127.0.0.1
SUBMISSIONS_DB_PATH=data/submissions.sqlite

# Deployment provenance (required when DEPLOYMENT_STAMP_VISIBLE=true)
DEPLOYMENT_STAMP_VISIBLE=true
DEPLOY_COMMIT_SHA=local-dev
DEPLOY_REF=refs/heads/local
DEPLOY_BUILD_TIME_UTC=2026-04-15T00:00:00Z
REQUEST_LAYOUT_CONTRACT_VERSION=request-desktop-modes-v5

# SEO runtime contract
SEO_ALLOW_INDEXING=false

# Runtime
APP_PORT=4850

# Notifications
NOTIFICATION_MODE=
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_INTERNAL_TO_EMAIL=service@robinsonseptic.com
NOTIFICATION_TO_EMAIL=service@robinsonseptic.com
NOTIFICATION_FROM_EMAIL=no-reply@robinsonseptic.com
NOTIFICATION_FROM_NAME=Robinson Septic Intake
NOTIFICATION_REPLY_TO_EMAIL=service@robinsonseptic.com
NOTIFICATION_LANE_TO_EMAIL_MAP=general:service@robinsonseptic.com;septic-service:dispatch@robinsonseptic.com;evaluation:realtor@robinsonseptic.com;rental:rentals@robinsonseptic.com;commercial-service:commercial@robinsonseptic.com
NOTIFICATION_SUBJECT_PREFIX=[LOCAL]
NOTIFICATION_DEVELOP_SAFE_INBOX_PATTERN=develop|sandbox|test
SMTP_PROFILE=generic
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Abuse controls
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MODE=file
SUBMISSION_RETENTION_DAYS=365

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_PROVIDER=internal

